# Variables públicas del navegador. Copiá a .env; nunca agregues secretos aquí.
# URL base del proyecto, por ejemplo https://tu-proyecto.supabase.co (sin /rest/v1)
VITE_SUPABASE_URL=
# Clave publicable/anon del mismo proyecto. Nunca uses la service_role key.
VITE_SUPABASE_ANON_KEY=
# URL de la API Express, incluida la versión. En desarrollo puede omitirse
# si Vite redirige /api al backend local.
VITE_API_URL=http://localhost:3001/api/v1
